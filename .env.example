# ── MQTT Broker ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# ── Azure SQL / Local SQLite fallback ──
DATABASE_URL=sqlite:///./precision_agri.db
# DATABASE_URL=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server

# ── FastAPI ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8501"]

# ── Streamlit ──
STREAMLIT_PORT=8501

# ── Simulator ──
SIM_FIELD_ID=field_01
SIM_NUM_NODES=16
SIM_PUBLISH_INTERVAL_S=10
SIM_PIVOT_ID=pivot_01
